{
  "name": "soloforge",
  "private": true,
  "version": "1.0.0",
  "description": "SoloForge - AI-powered code generation and preview platform",
  "author": "SoloForge",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node start.mjs",
    "dev:server": "tsx server.ts",
    "dev:electron": "node electron/launch.cjs .",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "package": "npm run build && electron-builder build --win --x64 --config.electronDist=node_modules/electron/dist",
    "package:dir": "npm run build && electron-builder build --win --x64 --dir --config.electronDist=node_modules/electron/dist"
  },
  "build": {
    "appId": "com.soloforge.app",
    "productName": "SoloForge",
    "copyright": "Copyright 2026 SoloForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/canvas/canvas-dist",
        "to": "canvas",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SoloForge",
      "installerSidebar": null
    }
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "^5.10.0",
    "@lobehub/ui": "^5.15.17",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "@surrealdb/node": "^3.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.0.3",
    "@vue/compiler-sfc": "^3.5.39",
    "antd": "^6.4.4",
    "cheerio": "^1.2.0",
    "detect-port": "^2.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "http-proxy-middleware": "^4.1.1",
    "ioredis": "^5.11.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "surrealdb": "2.0.3",
    "vite": "^8.1.0",
    "xstate": "^5.32.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "chrome-remote-interface": "^0.33.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "puppeteer-core": "^25.3.0",
    "react-is": "^18.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
