    "fill": {
      "key": "fill",
      "label": "填满当前宽度",
      "group": "desktop",
      "type": "2d",
      "nativeSize": { "w": 0, "h": 0 },
      "note": "非 3D 模式，使用现有 2D UI 预览逻辑"
    },

