# ============================================================
# SoloForge 后端 .env.example
# ============================================================
# 用法：复制此文件为 .env，填入实际值
#   cp .env.example .env
#
# 启动顺序（详见 README.md / project_rules.md）：
#   1) Garnet (6379)        — Redis 协议缓存
#   2) MARL Service (8765)  — Python 多智能体服务
#   3) SoloForge Backend    — 读此 .env 文件
# ============================================================

# ----- 服务端口 -----
# API_PORT=3001

# ----- LLM 代理 (P1) -----
# API key 永远只放后端，绝不出现在前端 bundle
# SOLOFORGE_LLM_PROVIDER=openai
# SOLOFORGE_LLM_API_KEY=sk-...
# SOLOFORGE_LLM_BASE_URL=https://api.openai.com/v1
# SOLOFORGE_LLM_MODEL=gpt-4o-mini
# SOLOFORGE_LLM_TIMEOUT_MS=60000

# ----- LLM 代理 token（可选） -----
# 留空 = 同源访问不校验；配了则前端必须在 header 带 X-SoloForge-Token
# SOLOFORGE_LLM_API_TOKEN=

# ----- Garnet (Redis 协议) -----
# GARNET_HOST=127.0.0.1
# GARNET_PORT=6379

# ----- MARL Service -----
# MARL_SERVICE_HOST=127.0.0.1
# MARL_SERVICE_PORT=8765

# ----- 其它（按需） -----
# NODE_ENV=development
# LOG_LEVEL=info
